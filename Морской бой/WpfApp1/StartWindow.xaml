<Window x:Class="WpfApp1.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
            <TextBlock Text="Введите ваш ник" TextAlignment="Center" FontSize="18" ></TextBlock>
            <TextBox x:Name="NameTextBox" Width="225" Height="47" FontSize="18" TextAlignment="Center" VerticalContentAlignment="Center"/>
            <Button Content = "Играть " Click="PlayButton_Click" Height="55" Width="226"/>

        </StackPanel>
    </Grid>
</Window>
