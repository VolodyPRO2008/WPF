<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="162"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Margin="50,0,50,40"
                BorderBrush="Black" BorderThickness="2" Padding="0">
            <ItemsControl ItemsSource="{Binding PlayerCells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="10" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color}"
                                BorderBrush="Gray"
                                BorderThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="1"
                       Margin="0,110,0,0" Text="Поле игрока" FontSize="30" TextAlignment="Center"
                   FontFamily="Impact"/>
        <Border Grid.Row="1" Grid.Column="1" Margin="50,0,50,40"
                BorderBrush="Black" BorderThickness="2" Padding="0">
            <ItemsControl ItemsSource="{Binding EnemyCells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="10" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="{Binding Color}"
                        BorderBrush="Gray"
                        BorderThickness="1" 
                        Command="{Binding DataContext.NewColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
                        
                        
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="1"
                       Margin="0,110,0,0" Text="Поле компьютера" FontSize="30" TextAlignment="Center"
                   FontFamily="Impact"/>
    </Grid>

</Window>
